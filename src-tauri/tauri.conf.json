{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "The Bridge",
  "version": "1.0.2",
  "identifier": "com.derivativesindicators.thebridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "bootstrap"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-ancestors": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Finance",
    "shortDescription": "Algorithmic Trading Platform",
    "longDescription": "The Bridge by Derivatives Indicators, based on OpenAlgo Desktop (AGPL-3.0). Connects to Indian brokers and executes trades via webhooks and APIs.",
    "copyright": "Copyright 2024 OpenAlgo; Modifications Copyright 2026 Derivatives Indicators. AGPL-3.0.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": null,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "^https?://"
    },
    "updater": {
      "pubkey": "REPLACE_WITH_OUR_UPDATER_PUBKEY",
      "endpoints": [
        "https://UPDATE-SERVER-PLACEHOLDER.invalid/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
